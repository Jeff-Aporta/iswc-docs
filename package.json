{
  "name": "isc-swagger",
  "version": "1.0.0",
  "private": true,
  "description": "Visor OpenAPI 3 de InSoft en web components (is-*). Sin React, sin MUI, sin Babel: TS -> ES modules planos + CDN is-webcomponents.",
  "type": "module",
