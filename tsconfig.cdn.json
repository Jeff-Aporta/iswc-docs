{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".tmp-dts",
    "rootDir": "."
  },
  "//": "Emite un .d.ts por cada .js publicado (src/js y view). El build los espeja a dist/cdn como los .js, para que los tests —que prueban dist/cdn como caja negra— no vean `any`.",
  "include": [
    "src/js/**/*.ts",
    "view/*/components/**/*.ts",
    "view/*/utils/**/*.ts",
    "src/types/**/*.d.ts"
  ]
}
