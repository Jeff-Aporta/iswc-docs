{
  "kind": "config",
  "version": 1,
  "info": {
    "title": "API PatyIA",
    "version": "1.0.0",
    "description": "Documentación de la API del ISS PatyIA.\n\n<iswc-callout tone=\"info\">Fixture de pruebas con la forma vigente del documento `doc`.</iswc-callout>"
  },
  "viewer": {
    "ns": "ISS",
    "brand": { "title": "ISS PatyIA", "icon": "mdi:robot-happy-outline" },
    "auth": { "enabled": true, "loginKind": "portal", "loginPath": "/api/auth/portal-login", "app": "isa-patyia", "provider": "patyia-portal" },
    "exports": {
      "openApiDownloadName": "iss-ayudascpia.openapi.json",
      "postmanDownloadName": "iss-ayudascpia.postman_collection.json",
      "isDownloadName": "iss-ayudascpia.is.json"
    },
    "nav": [
      { "id": "conversaciones", "label": "Conversaciones", "icon": "mdi:forum-outline", "tags": ["Conversaciones"] },
      { "id": "sistema", "label": "Sistema", "icon": "mdi:heart-pulse", "tags": ["Sistema"] }
    ],
    "servers": [
      { "url": "https://ayudascp-ia-staging.azurewebsites.net/api", "description": "Staging (Azure)" },
      { "url": "http://127.0.0.1:8802/api", "description": "Local (Functions)" }
    ]
  },
  "tags": [
    {
      "name": "Conversaciones",
      "description": "Chat y detalle de conversaciones.",
      "subgroups": [{ "id": "chat", "name": "Chat", "icon": "mdi:forum-outline", "description": "Turno SSE y detalle." }]
    },
    {
      "name": "Sistema",
      "description": "Configuración, salud y documentación.",
      "subgroups": [
        { "id": "configuracion", "name": "Configuración", "icon": "mdi:cog-outline", "description": "GET/PUT /sistema/cfg." },
        { "id": "documentacion", "name": "Documentación", "icon": "mdi:file-code-outline", "description": "GET /docs." }
      ]
    }
  ],
  "paths": {
    "/sistema/cfg": {
      "get": {
        "summary": "Ver la configuración del sistema",
        "description": "Lee la fila runtime de SYS_VALUES.",
        "tags": ["Sistema"],
        "subgroup": "configuracion",
        "security": "bearer",
        "doc": "sistema-cfg",
        "responses": { "template": "ok", "description": "Config SYS_VALUES.runtime", "payload": "sistema-cfg" }
      },
      "put": {
        "summary": "Guardar la configuración del sistema",
        "description": "Push parcial sobre la fila runtime.",
        "tags": ["Sistema"],
        "subgroup": "configuracion",
        "security": "bearer",
        "doc": "sistema-cfg-put",
        "requestBody": {
          "bodyKey": "sistema-cfg-put",
          "description": "Claves a cambiar.",
          "schema": { "type": "object", "properties": { "convlog": { "type": "boolean" } } }
        },
        "responses": { "template": "authForbidden", "description": "SYS_VALUES.runtime actualizado", "payload": "sistema-cfg" },
        "tryitConfirm": "sistema-cfg-put"
      }
    },
    "/conversacion/{iconversacion}": {
      "get": {
        "summary": "Detalle de una conversación",
        "description": "Mensajes y estado.",
        "tags": ["Conversaciones"],
        "subgroup": "chat",
        "security": "bearer",
        "doc": "conversacion-detalle",
        "parameters": [{ "name": "iconversacion", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "template": "authNotFound", "description": "Conversación", "payload": "conversacion" }
      },
      "delete": {
        "summary": "Eliminar una conversación",
        "description": "Borra la conversación propia.",
        "tags": ["Conversaciones"],
        "subgroup": "chat",
        "security": "bearer",
        "doc": "conversacion-detalle",
        "parameters": [{ "name": "iconversacion", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "template": "deleteEnvelope", "description": "Fila eliminada", "schema": "conversacion-row", "payload": "conversacion" }
      }
    },
    "/conversacion": {
      "post": {
        "summary": "Enviar un turno (SSE)",
        "description": "Responde con text/event-stream.",
        "tags": ["Conversaciones"],
        "subgroup": "chat",
        "security": "bearer",
        "doc": "conversacion-sse",
        "requestBody": { "bodyKey": "turno", "required": true, "description": "Prompt y, si existe, iconversacion." },
        "responses": {
          "template": "raw",
          "items": {
            "200": { "description": "text/event-stream: begin · message · end", "example": "event: message\ndata: {}\n\n" },
            "401": { "description": "Sin sesión" }
          }
        },
        "tryitAttachments": "conversacion"
      }
    },
    "/docs": {
      "get": {
        "summary": "Visor de la API",
        "description": "HTML con el visor; ?v=json devuelve este documento.",
        "tags": ["Sistema"],
        "subgroup": "documentacion",
        "security": "none",
        "doc": "docs",
        "responses": { "template": "raw", "items": { "200": { "description": "text/html (visor) · ?v=json · ?v=md · ?v=routes" } } }
      }
    }
  },
  "catalog": {
    "docs": {
      "sistema-cfg": "## Configuración\n\nLee `SYS_VALUES.runtime`.\n\n```http\nGET /api/sistema/cfg\n```\n",
      "sistema-cfg-put": "## Guardar\n\nPush parcial validado con Zod.",
      "conversacion-detalle": "## Detalle\n\nDevuelve la conversación si es del usuario.",
      "conversacion-sse": "## Turno\n\nEventos `begin`, `message`, `end`.",
      "docs": "## Visor\n\nEste mismo documento, servido como HTML."
    },
    "payloads": {
      "sistema-cfg": { "convlog": true, "clean_convlog": 30 },
      "conversacion": { "iconversacion": "c-1", "mensajes": [] }
    },
    "requestBodies": {
      "sistema-cfg-put": { "convlog": false },
      "turno": { "prompt": "Hola" }
    },
    "schemas": {
      "conversacion-row": { "type": "object", "properties": { "iconversacion": { "type": "string" } } }
    },
    "tryitConfirm": {
      "sistema-cfg-put": { "title": "Guardar configuración", "message": "Cambia la configuración del sistema." }
    },
    "tryitAttachments": { "templates": { "conversacion": { "images": { "field": "imagenes" } } } }
  }
}
